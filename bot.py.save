kkimport fix_ssl

import discord
from discord import app_commands
from discord.ext import commands
import json
import os
import re
import asyncio
import time
from dotenv import load_dotenv

load_dotenv()
TOKEN = os.getenv("DISCORD_TOKEN")

# === CONFIGURATION ===
STOCK_FILE = "stock.json"
SERVICES_FILE = "services.json"
PANEL_FILE = "panel.json"
COOLDOWN_FILE = "cooldowns.json"

LOG_CHANNEL_ID = 1551981969502511224          # Salon de logs restock
GEN_LOG_CHANNEL_ID = 1551949049178103941      # Salon où afficher les gens (mets l'ID du salon de gen)
GUILD_ID = 1551949048221536288                 # ID du serveur DREAM GEN
BANNER_URL = "https://i.imgur.com/WevuFGx.gif"

COOLDOWN_SECONDS = 60                          # 1 minute

# === SERVICES ===
DEFAULT_SERVICES = {
    "netflix":     {"emoji": "<:netflix:1551985544882294834>",     "color": 0xE50914},
    "steam":       {"emoji": "<:steam:1551985805327736934>",       "color": 0x1B2838},
    "minecraft":   {"emoji": "<:minecraft:1551985978942554132>",   "color": 0x44BD32},
    "microsoft":   {"emoji": "<:microsoft:1551986128859693096>",   "color": 0x00A4EF},
    "crunchyroll": {"emoji": "<:crunchyroll:1551986256332726312>", "color": 0xF47521},
}

# === CHARGEMENT / SAUVEGARDE ===
def load_json(path, default):
    if os.path.exists(path):
        with open(path, "r") as f:
            return json.load(f)
    return default

def save_json(path, data):
    with open(path, "w") as f:
        json.dump(data, f, indent=4)

stock = load_json(STOCK_FILE, {})
SERVICES = load_json(SERVICES_FILE, DEFAULT_SERVICES)
panel_data = load_json(PANEL_FILE, {"channel_id": None, "message_id": None})
cooldowns = load_json(COOLDOWN_FILE, {})

# === BOT ===
intents = discord.Intents.default()
intents.message_content = True
intents.guilds = True
bot = commands.Bot(command_prefix="!", intents=intents)

# === EMBED PANEL ===
def build_panel_embed():
    embed = discord.Embed(
        title="GÉNÉRATEUR DE COMPTES",
        description="Clique sur un bouton pour recevoir ton compte en DM.",
        color=0x2B2D31
    )
    embed.set_image(url=BANNER_URL)
    return embed

async def refresh_panel():
    if not panel_data["channel_id"] or not panel_data["message_id"]:
        return
    try:
        channel = bot.get_channel(panel_data["channel_id"])
        if not channel:
            return
        message = await channel.fetch_message(panel_data["message_id"])
        await message.edit(embed=build_panel_embed(), view=GenView())
    except Exception as e:
        print(f"⚠️ Refresh panel : {e}")

# === COOLDOWN CHECK ===
def is_owner(member: discord.Member) -> bool:
    """True si le membre est owner ou admin."""
    return member.guild_permissions.administrator or member.id == member.guild.owner_id

def get_remaining_cooldown(user_id: int) -> int:
    """Retourne le temps restant en secondes (0 si pas de cooldown)."""
    if str(user_id) not in cooldowns:
        return 0
    elapsed = time.time() - cooldowns[str(user_id)]
    remaining = COOLDOWN_SECONDS - elapsed
    return max(0, int(remaining))

def set_cooldown(user_id: int):
    cooldowns[str(user_id)] = time.time()
    save_json(COOLDOWN_FILE, cooldowns)

# === BOUTON DE GEN ===
class GenButton(discord.ui.Button):
    def __init__(self, service: str, emoji: str):
        super().__init__(
            label=service.capitalize(),
            style=discord.ButtonStyle.secondary,
            emoji=emoji if emoji else None,
            custom_id=f"gen_{service}"
        )
        self.service = service

    async def callback(self, interaction: discord.Interaction):
        service = self.service

        # === CHECK COOLDOWN ===
        if not is_owner(interaction.user):
            remaining = get_remaining_cooldown(interaction.user.id)
            if remaining > 0:
                await interaction.response.send_message(
                    f"Attends encore **{remaining}s** avant de regen.", ephemeral=True
                )
                return

        # === CHECK STOCK ===
        if service not in stock or not stock[service]:
            await interaction.response.send_message(
                f"Plus de stock pour **{service}**.", ephemeral=True
            )
            return

        # === GEN ===
        compte = stock[service].pop(0)
        save_json(STOCK_FILE, stock)

        dm_embed = discord.Embed(
            title=f"{service.capitalize()}",
            description=f"```{compte}```",
            color=SERVICES[service]["color"]
        )
        dm_embed.set_footer(text="DREAM GEN • Break The Grind")

        try:
            await interaction.user.send(embed=dm_embed)

            # Set cooldown (sauf owner)
            if not is_owner(interaction.user):
                set_cooldown(interaction.user.id)

            await interaction.response.send_message("Compte envoyé en DM.", ephemeral=True)

            # === MESSAGE DE GEN (auto-supprimé après 3 sec) ===
            if GEN_LOG_CHANNEL_ID:
                gen_channel = bot.get_channel(GEN_LOG_CHANNEL_ID)
                if gen_channel:
                    msg = await gen_channel.send(
                        f"{interaction.user.mention} a généré un compte **{service.capitalize()}**"
                    )
                    await asyncio.sleep(3)
                    try:
                        await msg.delete()
                    except discord.NotFound:
                        pass

            await refresh_panel()

        except discord.Forbidden:
            stock[service].insert(0, compte)
            save_json(STOCK_FILE, stock)
            await interaction.response.send_message("Active tes DMs.", ephemeral=True)

# === VUE ===
class GenView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)
        for service, data in SERVICES.items():
            self.add_item(GenButton(service, data["emoji"]))

# === /panel ===
@bot.tree.command(name="panel", description="Afficher le panel")
@app_commands.default_permissions(administrator=True)
async def panel(interaction: discord.Interaction):
    msg = await interaction.channel.send(embed=build_panel_embed(), view=GenView())
    panel_data["channel_id"] = msg.channel.id
    panel_data["message_id"] = msg.id
    save_json(PANEL_FILE, panel_data)
    await interaction.response.send_message("Panel envoyé.", ephemeral=True)

# === /addstock ===
@bot.tree.command(name="addstock", description="Ajouter des comptes")
@app_commands.default_permissions(administrator=True)
@app_commands.describe(service="Le service", comptes="Comptes séparés par , ou retour à la ligne")
async def addstock(interaction: discord.Interaction, service: str, comptes: str):
    service = service.lower()
    if service not in SERVICES:
        await interaction.response.send_message("Service inconnu.", ephemeral=True)
        return

    liste = [c.strip() for c in re.split(r"[,\n;]+", comptes) if c.strip()]
    if not liste:
        await interaction.response.send_message("Aucun compte valide.", ephemeral=True)
        return

    stock.setdefault(service, []).extend(liste)
    save_json(STOCK_FILE, stock)

    await interaction.response.send_message(
        f"**{len(liste)}** compte(s) ajouté(s) pour **{service}**. Stock : `{len(stock[service])}`",
        ephemeral=True
    )

    await refresh_panel()

    if LOG_CHANNEL_ID:
        log_channel = bot.get_channel(LOG_CHANNEL_ID)
        if log_channel:
            embed = discord.Embed(
                title="NOUVEAU RESTOCK",
                description=f"**{len(liste)}** compte(s) **{service.capitalize()}** ajoutés.",
                color=SERVICES[service]["color"]
            )
            embed.add_field(name="Service", value=f"{SERVICES[service]['emoji']} {service.capitalize()}", inline=True)
            embed.add_field(name="Ajoutés", value=f"`+{len(liste)}`", inline=True)
            embed.add_field(name="Stock total", value=f"`{len(stock[service])}`", inline=True)
            embed.set_footer(text=f"Ajouté par {interaction.user}", icon_url=interaction.user.display_avatar.url)
            await log_channel.send(embed=embed)

@addstock.autocomplete("service")
async def service_autocomplete(interaction: discord.Interaction, current: str):
    return [app_commands.Choice(name=s.capitalize(), value=s) for s in SERVICES.keys() if current.lower() in s.lower()]

# === /addservice ===
@bot.tree.command(name="addservice", description="Ajouter un service")
@app_commands.default_permissions(administrator=True)
async def addservice(interaction: discord.Interaction, nom: str, emoji: str, couleur: str = "2B2D31"):
    nom = nom.lower().strip()
    if nom in SERVICES:
        await interaction.response.send_message("Existe déjà.", ephemeral=True)
        return
    try:
        color_int = int(couleur.replace("0x", "").replace("#", ""), 16)
    except ValueError:
        color_int = 0x2B2D31
    SERVICES[nom] = {"emoji": emoji, "color": color_int}
    save_json(SERVICES_FILE, SERVICES)
    await interaction.response.send_message(f"Service **{nom}** ajouté.", ephemeral=True)

# === /stock ===
@bot.tree.command(name="stock", description="Voir le stock")
async def stock_cmd(interaction: discord.Interaction):
    if not stock:
        await interaction.response.send_message("Stock vide.", ephemeral=True)
        return
    msg = "**Stock :**\n"
    for service, comptes in stock.items():
        emoji = SERVICES.get(service, {}).get("emoji", "")
        msg += f"{emoji} **{service.capitalize()}** : `{len(comptes)}`\n"
    await interaction.response.send_message(msg, ephemeral=True)

# === /cooldown (admin) ===
@bot.tree.command(name="resetcooldown", description="Reset le cooldown d'un membre")
@app_commands.default_permissions(administrator=True)
async def resetcooldown(interaction: discord.Interaction, membre: discord.Member):
    if str(membre.id) in cooldowns:
        del cooldowns[str(membre.id)]
        save_json(COOLDOWN_FILE, cooldowns)
        await interaction.response.send_message(f"Cooldown de {membre.mention} reset.", ephemeral=True)
    else:
        await interaction.response.send_message(f"{membre.mention} n'a pas de cooldown.", ephemeral=True)

@bot.event
async def on_ready():
    await bot.tree.sync()
    guild = discord.Object(id=GUILD_ID)
    bot.tree.copy_global_to(guild=guild)
    synced = await bot.tree.sync(guild=guild)
    print(f"✅ {len(synced)} commandes sync")
    print(f"✅ Connecté : {bot.user}")

